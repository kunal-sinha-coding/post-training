def find_combinations(tup_list):
    """
    Find all combinations of sums from the given tuple list.
    
    Args:
        tup_list (list of tuples): List of tuples representing numbers.
        
    Returns:
        list of tuples: Combinations of sums.
    """
    if not tup_list:
        return []
    
    # Sort the list to ensure consistent ordering
    tup_list.sort()
    
    # Generate all possible sums
    sums = []
    for i in range(len(tup_list)):
        for j in range(i + 1, len(tup_list)):
            sums.append(tup_list[i] + tup_list[j])
    
    # Filter out duplicates (sums that are equal to another sum)
    unique_sums = list(set(sums))
    
    return unique_sums

