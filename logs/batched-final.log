import heapq

def combine_lists(sorted_list1, sorted_list2):
    """
    Combines two sorted lists using the heapq module.
    The function returns a new list containing all elements from both lists.
    """
    # Create a list of tuples to sort by the first element of the list
    # This allows us to use heapq to combine them
    combined = []
    for i in range(len(sorted_list1)):
        combined.append((sorted_list1[i], i))
    for i in range(len(sorted_list2)):
        combined.append((sorted_list2[i], i))
    
    # Sort the combined list by the first element of the list
    heapq.heapify(combined)
    
    # Combine the elements
    result = []
    while True:
        first, index = heapq.heappop(combined)
        result.append(first)
        if index < len(sorted_list1):
            break
        if index < len(sorted_list2):
            break
    
    return result

