def max_sum_list(lst):
    if not lst:
        return []
    
    max_sum = 0
    max_list = []
    
    for sublist in lst:
        current_sum = sum(sublist)
        if current_sum > max_sum:
            max_sum = current_sum
            max_list = sublist
    
    return max_list

