def find_triplet_array(arr, target, k):
    """
    Find if there is a triplet in the array whose sum is equal to a given value.
    
    Args:
        arr (list): List of integers
        target (int): Target sum
        k (int): Number of elements in the triplet (must be >= 3)
    
    Returns:
        tuple: (first_element, second_element, third_element) if found, else None
    """
    if len(arr) < k:
        return None
    
    # Sort the array to optimize the search
    arr.sort()
    
    # Use two pointers to find the triplet
    left, right = 0, len(arr) - 1
    
    while left < right:
        current_sum = arr[left] + arr[right] + arr[left + 1]
        
        if current_sum == target:
            return (arr[left], arr[right], arr[left + 1])
        
        elif current_sum < target:
            left += 1
        else:
            right -= 1
    
    return None

