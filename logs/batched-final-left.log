def check(arr, n):
    if n == 0:
        return True
    if n == 1:
        return True
    
    # Corner elements are arr[0] and arr[n-1]
    # If arr[0] > arr[n-1], then the array is sorted
    if arr[0] > arr[n-1]:
        return True
    
    # If arr[0] <= arr[n-1], we need to check if the array is sorted
    # by comparing adjacent elements
    for i in range(1, n - 1):
        if arr[i] > arr[i + 1]:
            return False
    
    return True

print(check([3,2,1,2,3,4], 6))
print(check([2,1,4,5,1], 5))
print(check([1,2,2,1,2,3], 6))

