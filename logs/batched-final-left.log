def sum_of_square(n):
    """
    Calculate the sum of squares of binomial coefficients C(n, k) for k from 0 to n.
    """
    total = 0
    for k in range(n + 1):
        total += binomial(n, k)
    return total

def binomial(n, k):
    """
    Calculate the binomial coefficient C(n, k) = n! / (k! * (n-k)!)
    """
    if k < 0 or k > n:
        return 0
    if k == 0 or k == n:
        return 1
    if k == 1 or k == n - 1:
        return 1
    # Use the property C(n, k) = C(n, n-k)
    return n * binomial(n - 1, k - 1)

