def find_fixed_point(arr, n):
    """
    Find the fixed point in the given array.
    A fixed point is an element that equals its index.
    
    Parameters:
    arr (list): The input array.
    n (int): The length of the array.
    
    Returns:
    int: The fixed point index.
    """
    for i in range(n):
        if arr[i] == i:
            return i
    return -1

