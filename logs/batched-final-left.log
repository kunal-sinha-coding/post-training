def sum_of_odd_factors(n):
    """
    Calculate the sum of all odd factors of a given number n.
    
    Parameters:
    n (int): The number to find factors of
    
    Returns:
    int: Sum of odd factors
    """
    if n <= 1:
        return 0
    
    odd_sum = 0
    odd_factors = []
    
    # Check for odd factors from 1 to sqrt(n)
    for i in range(1, int(n**0.5) + 1):
        if n % i == 0:
            if i % 2 == 1:  # Check if i is odd
                odd_sum += i
                if i != n // i:
                    odd_factors.append(i)
    
    # If n is a perfect square, add the root if it's odd
    if n % 2 == 0:
        if n % 2 == 1:
            odd_sum += n // 2
            odd_factors.append(n // 2)
    
    return odd_sum

# Test cases
assert sum_of_odd_factors(30) == 24
assert sum_of_odd_factors(18) == 13
assert sum_of_odd_factors(2) == 1

