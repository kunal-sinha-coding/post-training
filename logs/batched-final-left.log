def matrix_to_list(matrix):
    """
    Flattens a tuple matrix into a tuple list where each tuple represents a column.
    
    Args:
        matrix: A list of tuples, where each inner tuple represents a column.
    
    Returns:
        A tuple list where each element is a tuple representing a column.
    """
    if not matrix:
        return []
    
    # Flatten the matrix by concatenating all tuples
    flattened = []
    for col in matrix:
        flattened.append(tuple(col))
    
    return flattened

