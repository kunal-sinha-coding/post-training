def find_Min_Swaps(arr):
    """
    Find the minimum number of adjacent swaps required to sort a binary array.
    
    This is equivalent to finding the number of inversions in the array.
    """
    n = len(arr)
    inversions = 0
    for i in range(n):
        for j in range(i + 1, n):
            if arr[i] > arr[j]:
                inversions += 1
    return inversions

