def equilibrium_index(arr):
    """
    Find the equilibrium index of the given array.
    
    An equilibrium index is an index i such that:
    - arr[i] == arr[i + 1]
    - arr[i] == arr[i - 1]
    - arr[i] == arr[i + 2]
    - arr[i] == arr[i - 2]
    
    Returns the index i if it exists, otherwise -1.
    """
    n = len(arr)
    for i in range(n - 2):
        if arr[i] == arr[i + 1] and arr[i] == arr[i - 1] and arr[i] == arr[i + 2] and arr[i] == arr[i - 2]:
            return i
    return -1

