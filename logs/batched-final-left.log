def find_first_occurrence(arr, target):
    """
    Find the index of the first occurrence of a given number in a sorted array.
    
    Parameters:
    arr (list): A sorted list of integers.
    target (int): The number to search for.
    
    Returns:
    int: The index of the first occurrence of target, or -1 if not found.
    """
    left = 0
    right = len(arr) - 1
    while left < right:
        mid = (left + right) // 2
        if arr[mid] == target:
            return mid
        elif arr[mid] < target:
            left = mid + 1
        else:
            right = mid
    return -1

