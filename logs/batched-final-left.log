def Sum_of_Inverse_Divisors(n, m):
    """
    Calculate the sum of the inverse of divisors of n.
    The inverse of a divisor d is 1/d.
    """
    if n < 0:
        raise ValueError("n must be non-negative")
    if m < 0:
        raise ValueError("m must be non-negative")
    
    if n == 0:
        return 0
    
    total = 0
    for i in range(1, n + 1):
        if n % i == 0:
            d = i
            inv_d = 1.0 / d
            total += inv_d
    return total

