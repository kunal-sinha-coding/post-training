def find_Extra(sorted_array, extra_index):
    """
    Find the index of an extra element in a sorted array.
    
    Parameters:
    sorted_array (list): A sorted list of integers.
    extra_index (int): The index of the extra element to find.
    
    Returns:
    int: The index of the extra element, or -1 if not found.
    """
    # Check if the extra index is within the bounds of the array
    if extra_index < 0 or extra_index >= len(sorted_array):
        return -1
    
    # Check if the extra element is already present in the array
    for i in range(len(sorted_array)):
        if sorted_array[i] == sorted_array[extra_index]:
            return i
    
    return -1

