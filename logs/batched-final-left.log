def max_chain_length(pairs):
    """
    Find the length of the longest chain of pairs that can be formed.
    A chain is a sequence of pairs where each pair is a successor of the previous one.
    """
    if not pairs:
        return 0
    
    # Sort pairs by the first element of the pair
    sorted_pairs = sorted(pairs, key=lambda p: p[0])
    
    # Initialize the longest chain length
    max_chain_length = 1
    
    # Iterate through the sorted pairs
    for i in range(1, len(sorted_pairs)):
        current_pair = sorted_pairs[i]
        prev_pair = sorted_pairs[i - 1]
        
        # If the first element of the current pair is greater than the first element of the previous pair,
        # we can extend the chain. Otherwise, we can't.
        if current_pair[0] > prev_pair[0]:
            max_chain_length += 1
        else:
            # If the first element is smaller or equal, we can't extend the chain
            # because we need strictly increasing first elements.
            break
    
    return max_chain_length

