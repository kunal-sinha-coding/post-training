def check_min_heap(arr, k):
    """
    Check if the array represents a min heap.
    
    A min heap is a complete binary tree where the parent node is less than or equal to
    its children.
    
    Args:
        arr (list): List of integers representing the heap.
        k (int): The index of the root node (0-based).
    
    Returns:
        bool: True if the array represents a min heap, False otherwise.
    """
    if len(arr) < k + 1:
        return False
    
    # Check if the root is smaller than all its children
    for i in range(k + 1, len(arr)):
        if arr[i] > arr[k]:
            return False
    
    return True

