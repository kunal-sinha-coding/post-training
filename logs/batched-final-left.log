def toggle_middle_bits(n):
    # Convert to binary string
    binary_str = bin(n)[2:]
    
    # Find the middle index (0-based)
    middle_index = len(binary_str) // 2
    
    # Toggle bits at middle index
    result = 0
    for i in range(len(binary_str)):
        if i == middle_index:
            result |= (1 << (i + 1))
        else:
            result &= ~(1 << (i + 1))
    
    # Convert back to integer
    return int(result, 2)

print(toggle_middle_bits(9))  # 15
