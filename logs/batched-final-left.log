def find_First_Missing(nums, start, end):
    """
    Find the smallest missing number from the given array.
    
    Args:
        nums (list): The input array of numbers.
        start (int): The starting index to consider.
        end (int): The ending index to consider.
    
    Returns:
        int: The smallest missing number from the range [start, end].
    """
    if not nums:
        return start + 1
    
    # Count occurrences of each number in the range [start, end]
    count = {}
    for i in range(start, end + 1):
        count[nums[i]] = count.get(nums[i], 0) + 1
    
    # Find the first number that appears exactly once
    for num in count:
        if count[num] == 1:
            return num
    
    # If no number appears exactly once, return end + 1
    return end + 1

