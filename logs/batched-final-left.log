import re

def capital_words_spaces(s):
    # Pattern to match words starting with capital letters
    # We use a negative lookahead to ensure the word is not followed by another word
    pattern = r'^(?P<word>[\w]+(?!\w))'
    # Split by the pattern and join with spaces
    return re.split(pattern, s)

