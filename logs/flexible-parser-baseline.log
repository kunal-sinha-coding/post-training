def camel_to_snake(s):
    if not s:
        return s
    result = []
    for char in s:
        if char.isupper():
            result.append(char)
        elif char in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ':
            result.append(char)
        else:
            if result and result[-1].isupper():
                result.append('_')
            result.append(char)
    return ''.join(result)

